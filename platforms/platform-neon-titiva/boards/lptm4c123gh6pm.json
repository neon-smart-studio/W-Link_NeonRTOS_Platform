{
  "build": {
    "core": "tivac",
    "cpu": "cortex-m4",
    "ldscript": "lptm4c123.ld",
    "extra_flags": [
      "-DPART_TM4C123GH6PM",
      "-DTARGET_IS_TM4C123_RB1",
      "-DTM4C123"
    ],
    "f_cpu": "80000000L",
    "mcu": "lptm4c123gh6pm",
    "variant": "EK-TM4C123GXL"
  },
  "debug": {
    "svd_path": "TM4C123GH6PM.svd",
    "tools": {
      "ti-icdi": {
        "onboard": true,
        "server": {
          "arguments": [
            "-s", "$PACKAGE_DIR/scripts",
            "-f", "board/ek-tm4c123gxl.cfg"
          ],
          "executable": "bin/openocd",
          "package": "tool-openocd"
        }
      }
    }
  },
  "frameworks": [
    "libopencm3"
  ],
  "name": "TI LaunchPad (Tiva C) w/ tm4c123 (80MHz)",
  "upload": {
    "maximum_ram_size": 32768,
    "maximum_size": 262144
  },
  "url": "http://www.ti.com/ww/en/launchpad/launchpads-connected-ek-tm4c123gxl.html",
  "vendor": "TI"
}
